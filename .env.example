# Copy to .env.local for `vercel dev`, and set the same names in Vercel → Settings → Environment Variables.
# Never commit real values.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=           # public, goes to the browser
SUPABASE_SERVICE_ROLE_KEY=   # secret, server only

# Anthropic Console → API Keys
ANTHROPIC_API_KEY=

# Claude requests per person per day
AI_DAILY_LIMIT=40
